{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luix-lab.local/schemas/task.schema.json",
  "title": "Luix AI Network Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "title",
    "objective",
    "permissions",
    "constraints",
    "deliverables",
    "acceptance_criteria",
    "owner",
    "status",
    "protocol_version"
  ],
  "properties": {
    "task_id": { "type": "string", "pattern": "^[A-Z]{2,8}-[0-9]{3,6}$" },
    "title": { "type": "string", "minLength": 3 },
    "objective": { "type": "string", "minLength": 5 },
    "context": { "type": "string" },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "permissions": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "deliverables": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "owner": { "type": "string", "minLength": 1 },
    "assigned_agent": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": ["draft", "queued", "sent", "received", "in_progress", "blocked", "submitted", "under_review", "accepted", "rejected", "cancelled"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "protocol_version": { "const": "1.0" },
    "evidence_refs": { "type": "array", "items": { "type": "string" } }
  }
}